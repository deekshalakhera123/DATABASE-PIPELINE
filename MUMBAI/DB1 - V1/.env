# =============================================================================
# DB1 Pipeline — Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control — add it to .gitignore.
# =============================================================================

# ----------------------------------------------------------------------------
# Gemini / Google Generative AI
# Required by Stage 2 (LLM extraction).
# Get your key at: https://aistudio.google.com/app/apikey
# ----------------------------------------------------------------------------
GOOGLE_API_KEY=your-google-api-key-here

# ----------------------------------------------------------------------------
# Stage 1 — Input / Output paths
# Paths are relative to the script's working directory unless absolute.
# ----------------------------------------------------------------------------
STAGE1_IGR_EXCEL=.\sample_data.xlsx
STAGE1_VILLAGE_DIR=.\Excels Required for DB1\Mumbai IGR Village Directory.xlsx
STAGE1_OUTPUT_SALE=Sample Sale data for llm.xlsx
STAGE1_OUTPUT_LEASE=Sample Lease data for llm.xlsx
STAGE1_OUTPUT_OTHER=Sample Other data for llm.xlsx

# Date format: TRUE = MM/DD/YYYY (American), FALSE = DD/MM/YYYY (Indian)
STAGE1_REGISTRATION_DATE_MDY=True
STAGE1_EXECUTION_DATE_MDY=True

# ----------------------------------------------------------------------------
# Stage 2 — LLM Processing
# ----------------------------------------------------------------------------
STAGE2_INPUT_EXCEL=Sample Sale data for llm.xlsx
STAGE2_INPUT_SHEET=Sheet1
STAGE2_TEMP_CSV=temp_bhumapan_data.csv
STAGE2_CHUNK_DIR=extracted_chunks
STAGE2_FINAL_OUTPUT=llm processed Sale data for manual.xlsx

# Gemini model to use (e.g. gemma-3-27b-it, gemini-1.5-flash, gemini-2.0-flash)
STAGE2_MODEL_NAME=gemma-3-27b-it
STAGE2_CHUNK_SIZE=50
STAGE2_MAX_WORKERS=1
# Set to True to resume from the last completed chunk; False to start fresh.
STAGE2_RESUME=True
STAGE2_RETRIES=3

# ----------------------------------------------------------------------------
# Stage 3 — Post-Manual Processing
# ----------------------------------------------------------------------------
STAGE3_CITY=mumbai
STAGE3_INPUT_PATH=manual processed Sale data for manual.xlsx
STAGE3_RERA_GRAND_PATH=.\Excels Required for DB1\mumbai RERA GRAND EXCEL VERSION.xlsx
STAGE3_RERA_KEYWORDS_PATH=.\Excels Required for DB1\RERA_All_Keywords_BHK_Prop_Type.xlsx
STAGE3_COORDINATES_PATH=.\Excels Required for DB1\project address and its coordinates.xlsx
STAGE3_VILLAGE_DIR_PATH=.\Excels Required for DB1\Mumbai IGR Village Directory.xlsx
STAGE3_POSTAL_CSV_PATH=.\Excels Required for DB1\postal_pincode.csv
STAGE3_OUTPUT_PATH=sample_file_for_db1.xlsx
STAGE3_BHK_MAX_DIFF=5
